# Copie este arquivo para .env.local e preencha com os dados do seu projeto no Supabase
# (Project Settings > API). Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Opcional: avaliação das entrevistas pelo Claude (console.anthropic.com > API Keys).
# Sem esta chave, o botão "Avaliar com o Claude" não aparece e as notas são dadas pelo gestor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcional: endereço público do site (ex.: https://hayah.vercel.app), usado nos links de convite e devolutiva.
# Sem ele, o endereço é descoberto pela própria requisição.
NEXT_PUBLIC_SITE_URL=
